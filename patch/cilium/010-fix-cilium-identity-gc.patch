-					}).Error("Deleting unused identity")
-					// If Context was canceled we should break
-					if ctx.Err() != nil {
-						break
-					}
-				}
-			}
-		}
-
-		identityHeartbeat.GC()
-	}, c.GCInterval, 1.1, false, ctx.Done())
-	logrus.WithField(logFieldCilium, "cilium").Debugf("GC loop end")
-}
