-		Client: c.Client.CoordinationV1(),
-		LockConfig: resourcelock.ResourceLockConfig{
-			Identity: id,
-		},
-	}
-	// start the leader election code loop
-	go func() {
-		for {
-			leaderelection.RunOrDie(context.TODO(), leaderelection.LeaderElectionConfig{
-				Lock:            lock,
-				ReleaseOnCancel: true,
